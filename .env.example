# ============================================================================
# Environment Variables — Facilitate Studio
# ============================================================================
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and safe for secrets.

# --- AI / SOP Step Extraction ---
# Required for the "Upload an SOP" feature to use OpenAI for step extraction.
# If omitted, SOP uploads will fail (AI is required).
# On Vercel, set this in the project's Environment Variables settings.
OPENAI_API_KEY=

# Optional: override the default OpenAI model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Local dev (recommended):
# - Put your key in `.env.local`
# - Run: `npm run dev`
# This starts a small local API server on port 8787 and proxies `/api/*` calls from Vite.
