# ============================================================================
# Environment Variables — Facilitate Studio
# ============================================================================
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and safe for secrets.

# --- AI / SOP Step Extraction ---
# Required for the "Upload an SOP" feature to use OpenAI for step extraction.
# If omitted, SOP uploads will fail (AI is required).
# On Vercel, set this in the project's Environment Variables settings.
OPENAI_API_KEY=

# Optional: override the default OpenAI model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- AI / 3D Image-to-Model Generation ---
# Provider to use for image-based 3D generation.
# Supported: meshy | tripo
AI_3D_PROVIDER=meshy

# Required when AI_3D_PROVIDER=meshy
MESHY_API_KEY=

# Required when AI_3D_PROVIDER=tripo
TRIPO_API_KEY=

# Optional generation-specific rate limits (requests per minute).
# If omitted, defaults are applied in API handlers.
AI_3D_RATE_LIMIT_PER_USER=10
AI_3D_RATE_LIMIT_PER_IP=20

# --- AI / World Labs 3D Environment Generation ---
# Required for image-to-world environment generation via World Labs Marble API.
WORLD_LABS_API_KEY=

# Optional world environment-specific rate limits (requests per minute).
AI_WORLD_ENV_RATE_LIMIT_PER_USER=5
AI_WORLD_ENV_RATE_LIMIT_PER_IP=10

# --- Supabase (Backend) ---
# Required for user accounts, cloud storage, and project persistence.
# Get these from your Supabase project's Settings > API page.
# The anon key is safe for the browser (it's a publishable key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase URL for backend API routes.
# Usually the same value as VITE_SUPABASE_URL. The dev server falls back to
# VITE_SUPABASE_URL automatically, but Vercel requires this set explicitly.
SUPABASE_URL=

# Server-only key used by backend API routes (never expose in client code).
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI endpoint rate limits (requests per minute).
# Per-user limit applies first, then per-IP limit as a fallback.
AI_RATE_LIMIT_PER_USER=10
AI_RATE_LIMIT_PER_IP=20

# --- Sentry Error Tracking (Optional) ---
# Frontend runtime error tracking (safe for client bundle).
VITE_SENTRY_DSN=
# Backend/API error tracking (server-side only).
SENTRY_DSN=
# Optional source map upload configuration for CI/release builds.
# If these are not set, source map upload is skipped automatically.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Local dev (recommended):
# - Put your key in `.env.local`
# - Run: `npm run dev`
# This starts a small local API server on port 8787 and proxies `/api/*` calls from Vite.
