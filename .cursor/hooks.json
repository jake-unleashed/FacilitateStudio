{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/session-start.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/session-end.mjs"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node .cursor/hooks/agent-response-worklog.mjs"
      }
    ]
  }
}
